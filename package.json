{
  "name": "gearbox-pro-desktop",
  "version": "5.0.7",
  "description": "GearBox Pro减速机参数化设计及建模系统 Windows 桌面端 (Electron)",
  "main": "src/main/main.js",
  "author": "GearBox Pro Engineering Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.js",
    "verify": "node scripts/verify-build.js",
    "start": "npm run prepare-assets && electron .",
    "build:win": "npm run prepare-assets && npm run verify && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "25.1.8",
    "tailwindcss": "3.4.17"
  },
  "build": {
    "appId": "com.gearboxpro.desktop.v5",
    "productName": "GearBox Pro减速机参数化设计及建模系统",
    "copyright": "Copyright © 2026 GearBox Pro",
    "publish": [
      {
        "provider": "github",
        "owner": "past-past",
        "repo": "GearBox_Pro_V5.0",
        "releaseType": "release"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/main/**/*",
      "src/renderer/**/*",
      "build/icon.png",
      "!license-server/**",
      "!src/main/license/private.pem",
      "!**/*.pem.bak",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "GearBoxPro-V${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GearBox Pro减速机参数化设计及建模系统",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "2052"
    },
    "portable": {
      "artifactName": "GearBoxPro-V${version}-Windows-${arch}-Portable.${ext}"
    }
  }
}
